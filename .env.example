# Copiar a `.env` y rellenar. Nunca commitear secretos.
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
PRIVATE_KEY=

# Cap de fee del protocolo en basis points (1000 = 10%). Debe respetar MAX inmutable on-chain.
PROTOCOL_FEE_BPS=1000

# Intervalo mínimo entre reportes oracle (segundos) para lab / deploy.
ORACLE_REPORT_INTERVAL=3600
