# Copiar a `.env` y rellenar. Nunca commitear secretos.
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
PRIVATE_KEY=

# Fee del protocolo en basis points (1000 = 10%). Cap on-chain MAX = 1000.
PROTOCOL_FEE_BPS=1000
# Porción del fee mint hacia treasury (resto → node operators).
TREASURY_SHARE_BPS=5000

# Intervalo mínimo entre reportes oracle (segundos).
ORACLE_REPORT_INTERVAL=3600

# Direcciones (vacío ⇒ deployer / Anvil #0).
TREASURY=
NODE_OPERATORS=
ORACLE_MEMBER=

# Withdrawal credentials Eth2 (bytes32 hex). Default: 0x01 || zeros || deployer.
WITHDRAWAL_CREDENTIALS=

# 1 = deploy MockDepositContract (lab). 0 = usar DEPOSIT_CONTRACT.
USE_MOCK_DEPOSIT=1
# Mainnet Eth2 deposit: 0x00000000219ab540356cBB839Cbe05303d7705Fa
DEPOSIT_CONTRACT=
